# Backend configuration
DATABASE_URL=postgresql+asyncpg://skilllens:skilllens@localhost:5432/skilllens
SECRET_KEY=replace-with-a-long-random-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
ANTHROPIC_API_KEY=
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
DEBUG=false

# Docker Compose database password
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Frontend deployment configuration. Set this in frontend/.env.local locally
# or as VITE_API_URL in the frontend deployment provider.
# VITE_API_URL=https://your-api.example.com
